<!-- Rebar Renumber form.
     Control names are used by Renumber-script.py: Select_partition, partition_info, action_combo,
     row_number/Select_rebar_number, row_value/value_label/New_Rebar_number,
     row_target/target_partition, row_pick/pick_info/pick_button, action_hint, status_text,
     select_button, cancel_button, apply_button, ok_button.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rebar Renumber" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="12">

        <!-- Partition -->
        <Grid Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Partition:" VerticalAlignment="Center"/>
            <ComboBox x:Name="Select_partition" Grid.Column="1"/>
        </Grid>
        <TextBlock x:Name="partition_info" Margin="120,0,0,10" Foreground="Gray" TextWrapping="Wrap"/>

        <!-- Action -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Action:" VerticalAlignment="Center"/>
            <ComboBox x:Name="action_combo" Grid.Column="1"/>
        </Grid>

        <!-- Current number (Change / Swap) -->
        <Grid x:Name="row_number" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Rebar number:" VerticalAlignment="Center"/>
            <ComboBox x:Name="Select_rebar_number" Grid.Column="1" IsEditable="False"/>
        </Grid>

        <!-- Numeric value (new number / swap with / start number) -->
        <Grid x:Name="row_value" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="value_label" Text="New number:" VerticalAlignment="Center"/>
            <TextBox x:Name="New_Rebar_number" Grid.Column="1" Padding="2"/>
        </Grid>

        <!-- Move to partition -->
        <Grid x:Name="row_pick" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Bars to move:" VerticalAlignment="Center"/>
            <TextBlock x:Name="pick_info" Grid.Column="1" VerticalAlignment="Center"/>
            <Button x:Name="pick_button" Grid.Column="2" Content="Pick bars..." Width="85"/>
        </Grid>
        <Grid x:Name="row_target" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Target partition:" VerticalAlignment="Center"/>
            <ComboBox x:Name="target_partition" Grid.Column="1" IsEditable="True"/>
        </Grid>

        <TextBlock x:Name="action_hint" Margin="0,2,0,6" Foreground="Gray" TextWrapping="Wrap" FontStyle="Italic"/>
        <TextBlock x:Name="status_text" Margin="0,0,0,6" TextWrapping="Wrap" FontWeight="SemiBold"/>

        <!-- Buttons -->
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="select_button" Content="Select in model" Width="110"
                    ToolTip="Close the dialog and select the bars this action applies to"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="cancel_button" Content="Close" Width="80" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="apply_button" Content="Apply" Width="80" Margin="0,0,8,0"/>
                <Button x:Name="ok_button" Content="OK" Width="80" IsDefault="True"
                        ToolTip="Apply and close"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
